# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/pune_caring_hands

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=8h

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─── Frontend (Public Web) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Frontend (Admin) ────────────────────────────────────────────────────────
# Set this in apps/admin/.env.local for the admin app
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── File Storage ────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=pune-caring-hands
STORAGE_REGION=ap-south-1

# ─── UPI ─────────────────────────────────────────────────────────────────────
UPI_ID=replace_with_upi_id
UPI_NAME=Pune Caring Hands

# ─── Seed (development only) ─────────────────────────────────────────────────
# Used by prisma/seed.ts — set these before running pnpm db:seed
# Never use production credentials here
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_password
